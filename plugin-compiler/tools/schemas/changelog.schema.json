{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "changelog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "basis",
    "changes"
  ],
  "properties": {
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "befund",
          "titel",
          "dateien"
        ],
        "properties": {
          "befund": {
            "type": "string",
            "pattern": "^[A-Z0-9]+$"
          },
          "titel": {
            "type": "string",
            "minLength": 1
          },
          "warum": {
            "type": "string",
            "minLength": 1
          },
          "dateien": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
