{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "component-agent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "source",
    "stage",
    "type",
    "frontmatter"
  ],
  "properties": {
    "kind": {
      "const": "agent"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "spec-review",
        "plan-review",
        "implementation",
        "implementation-review"
      ]
    },
    "type": {
      "enum": [
        "reviewer",
        "scout",
        "verifier",
        "rework",
        "implementer",
        "task-reviewer",
        "re-reviewer",
        "final-reviewer"
      ]
    },
    "frontmatter": {
      "type": "object",
      "required": [
        "name",
        "description",
        "model"
      ],
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "folded"
            ],
            "properties": {
              "folded": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        }
      }
    }
  }
}
