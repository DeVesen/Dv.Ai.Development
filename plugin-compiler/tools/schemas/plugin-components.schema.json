{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plugin-components",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "dir",
    "version",
    "description",
    "source",
    "assets",
    "hooks"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "dir": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "equivalent_to": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "UserPromptSubmit",
          "PreToolUse",
          "PostToolUse",
          "Stop",
          "SessionEnd",
          "SessionStart",
          "SubagentStop"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commands"
          ],
          "properties": {
            "matcher": {
              "type": "string",
              "minLength": 1
            },
            "commands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*\\.js( [a-z-]+)*$"
              }
            }
          }
        }
      }
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "equivalence_ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^#]+\\.json#[a-z]+$"
      }
    },
    "changelog": {
      "type": "string",
      "minLength": 1
    }
  }
}
