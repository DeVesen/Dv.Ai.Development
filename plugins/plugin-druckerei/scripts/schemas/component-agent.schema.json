{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "component-agent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "source"
  ],
  "properties": {
    "kind": {
      "const": "agent"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "frontmatter": {
      "type": "object",
      "required": [
        "name",
        "description",
        "model"
      ],
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "folded"
            ],
            "properties": {
              "folded": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        }
      }
    },
    "frontmatter_roh": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "required": [
        "frontmatter"
      ]
    },
    {
      "required": [
        "frontmatter_roh"
      ]
    }
  ]
}
