{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "component-doc",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "source"
  ],
  "properties": {
    "kind": {
      "enum": [
        "shared",
        "reference",
        "readme",
        "command",
        "doc"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "frontmatter": {
      "type": "object",
      "required": [],
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "folded"
            ],
            "properties": {
              "folded": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        }
      }
    },
    "frontmatter_roh": {
      "type": "string",
      "minLength": 1
    }
  }
}
