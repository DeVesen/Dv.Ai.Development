{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "phase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "after",
    "description",
    "argument_hint",
    "role",
    "source",
    "inputs",
    "outputs",
    "gate",
    "rules",
    "required"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "after": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "argument_hint": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "primary_input": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "criteria"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "criteria": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^R-[0-9]{3}$"
      }
    },
    "partials": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "source",
          "body"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "subject",
        "model",
        "tools",
        "input_lines",
        "checks",
        "not_mine",
        "categories"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "model": {
          "enum": [
            "sonnet",
            "opus",
            "haiku",
            "inherit"
          ]
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "Read",
              "Grep",
              "Glob"
            ]
          }
        },
        "input_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "text"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "not_mine": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inherit"
              ],
              "properties": {
                "inherit": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "set": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "severity",
                      "meaning"
                    ],
                    "properties": {
                      "severity": {
                        "enum": [
                          "red",
                          "yellow",
                          "green"
                        ]
                      },
                      "meaning": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z-]*$",
                "not": {
                  "enum": [
                    "inherit",
                    "set"
                  ]
                }
              },
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "severity",
                  "meaning"
                ],
                "properties": {
                  "severity": {
                    "enum": [
                      "red",
                      "yellow",
                      "green"
                    ]
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
