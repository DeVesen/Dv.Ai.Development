{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plugin-components",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "dir",
    "version",
    "description",
    "source"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "dir": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "equivalent_to": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "pattern": "^(\\.|[a-z0-9][a-z0-9._-]*)$"
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z]+$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commands"
          ],
          "properties": {
            "matcher": {
              "type": "string",
              "minLength": 1
            },
            "commands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*\\.js( [a-z-]+)*$"
                  },
                  {
                    "type": "object",
                    "required": [
                      "command"
                    ],
                    "properties": {
                      "command": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                ]
              }
            }
          }
        }
      }
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "equivalence_ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^#]+\\.json#[a-z]+$"
      }
    },
    "changelog": {
      "type": "string",
      "minLength": 1
    },
    "intern_zusatz": {
      "type": "string",
      "minLength": 1
    },
    "verweis_praefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "etappen_abgleich": {
      "enum": [
        "session-chain"
      ]
    },
    "lint": {
      "enum": [
        "streng",
        "bestand"
      ]
    },
    "plugin_json": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "name",
            "version",
            "description"
          ]
        }
      }
    }
  }
}
